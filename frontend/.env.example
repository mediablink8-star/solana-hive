# SOLANA HIVE Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# Backend API URL (must be HTTPS for production)
NEXT_PUBLIC_API_URL=https://solana-hive-backend.vercel.app

# WebSocket URL (must be WSS for production)
NEXT_PUBLIC_WS_URL=wss://solana-hive-backend.vercel.app